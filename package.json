{
  "name": "morphos",
  "version": "1.8.0-alpha.0",
  "description": "JSON-to-JSON mapper with user-defined JSON mapping specs, plain JS transformation expressions, and secure VM execution.",
  "keywords": [
    "config-driven",
    "data-mapper",
    "data-transformation",
    "json-mapper",
    "json-to-json",
    "json-transformation",
    "json-transformer",
    "json",
    "mapper",
    "mapping",
    "declarative-mapper",
    "nodejs",
    "object-mapper",
    "object-mapping",
    "transformation",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=16"
  },
  "main": "dist/cjs/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./react": {
      "require": "./dist/cjs/react/index.js",
      "import": "./dist/esm/react/index.js",
      "types": "./dist/types/react/index.d.ts"
    },
    "./react/bootstrap34": {
      "require": "./dist/cjs/react/bootstrap34/index.js",
      "import": "./dist/esm/react/bootstrap34/index.js",
      "types": "./dist/types/react/bootstrap34/index.d.ts"
    },
    "./react/bootstrap53": {
      "require": "./dist/cjs/react/bootstrap53/index.js",
      "import": "./dist/esm/react/bootstrap53/index.js",
      "types": "./dist/types/react/bootstrap53/index.d.ts"
    },
    "./openai": {
      "require": "./dist/cjs/openai/index.js",
      "import": "./dist/esm/openai/index.js",
      "types": "./dist/types/openai/index.d.ts"
    }
  },
  "files": [
    "dist/**",
    "!dist/.tsbuildinfo*",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "react": ">=18",
    "openai": ">=4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "scripts": {
    "cleanup": "rm -rf ./dist ./coverage",
    "playground": "vite",
    "build:playground": "vite build",
    "test": "jest",
    "test:coverage": "jest --collect-coverage",
    "changelog": "conventional-changelog -n ./scripts/changelog/index.cjs -r 0 > CHANGELOG.md",
    "rebuild": "npm run cleanup && npm run build",
    "build": "npm run build:esm && npm run build:cjs && npm run build:schemas",
    "build:cjs": "tsc -p ./tsconfig.cjs.json && cp ./scripts/etc/cjs-package.json ./dist/cjs/package.json",
    "build:esm": "tsc -p ./tsconfig.esm.json",
    "build:schemas": "mkdir -p ./dist/schemas && cp ./schemas/*.json ./dist/schemas/",
    "prepack": "npm t && npm run rebuild",
    "preversion": "npm audit --audit-level=low && npm t",
    "version": "./scripts/cleanup_obsolete_tags.sh v$npm_package_version && npm run changelog && git add CHANGELOG.md",
    "lint": "eslint"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/snatalenko/morphos.git"
  },
  "author": "@snatalenko",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/snatalenko/morphos/issues"
  },
  "homepage": "https://github.com/snatalenko/morphos#readme",
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/jest": "^29.5.14",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^20.19.35",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.1",
    "chai": "^4.5.0",
    "conventional-changelog-cli": "^3.0.0",
    "eslint": "^10.0.2",
    "eslint-plugin-jest": "^29.15.0",
    "globals": "^17.4.0",
    "jest": "^29.7.0",
    "jsonschema": "^1.5.0",
    "openai": "^6.37.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.12"
  }
}
